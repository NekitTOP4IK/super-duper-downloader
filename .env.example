SITE_ADDRESS=:80
BACKEND_IMAGE=sdd-backend:local
WEB_IMAGE=sdd-web:local
EGRESS_IMAGE=sdd-egress:local

REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
COBALT_URL=http://cobalt:9000
PROXY_URL=
# Comma-separated networks workers may reach although they look private, e.g. 198.18.0.0/15
# when the host resolves through a fake-ip proxy (Clash, sing-box).
EGRESS_ALLOW_CIDRS=
# Comma-separated public networks workers must not reach either, such as this server's own address.
EGRESS_DENY_CIDRS=

MAX_DURATION_SEC=10800
MAX_FILESIZE_MB=2048
MAX_BATCH_URLS=50
MAX_PLAYLIST_ITEMS=50
MAX_QUEUE=500
MAX_PROBE_QUEUE=100
MIN_FREE_DISK_GB=5
WORKER_CONCURRENCY=3
PROBE_CONCURRENCY=10
JOB_TIMEOUT_SEC=1800
FILE_TTL_HOURS=6
# Per client address; 0 turns a limit off.
RATE_PROBES_PER_MINUTE=30
RATE_DOWNLOADS_PER_HOUR=100
