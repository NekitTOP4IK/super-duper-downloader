{
	servers {
		# A proxy in front, such as nginx on the same host, reaches Caddy from a private
		# address. Strict mode takes the client from the right of X-Forwarded-For, past what
		# a client could put there itself.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS::80} {
	header {
		# Thumbnails come straight from the sites' CDNs, hence https: for images.
		Content-Security-Policy "default-src 'self'; img-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/* {
		# The API reads whole JSON bodies and spools uploads to disk before checking their size.
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		# Only here: text/event-stream from the API must reach the browser uncompressed.
		encode zstd gzip
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
